# Copy this file to .env and fill in real values. Never commit .env.

# Port the Express server listens on
PORT=3000

# MongoDB Atlas connection string (Atlas -> Database -> Connect -> Drivers).
# Replace <username>, <password> and <cluster> with your own values.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/hangout-planner?retryWrites=true&w=majority
